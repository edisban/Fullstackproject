# Copy this file to `.env` (same directory) and replace EVERY "change-me" value before running docker compose.
# Generate strong random secrets with:   openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_DB=Project_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

# --- Redis (token revocation + login rate limiting) ---
REDIS_PASSWORD=change-me-redis-password

# --- Authentication ---
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Token lifetime in milliseconds (24h)
JWT_EXPIRATION=86400000
# Set to true when the app is served over HTTPS (required in production).
AUTH_COOKIE_SECURE=false

# --- Administrator account (created on first start; can see every project) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

# --- Ports on the host ---
FRONTEND_PORT=4173
# Only used with docker-compose.debug.yml (bound to 127.0.0.1).
BACKEND_PORT=8082
DB_PORT=5433
REDIS_PORT=6380
